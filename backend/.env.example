# 상대 경로는 backend/ 기준입니다. 배포 기본 경로는 /app/data/askmate.db입니다.
DATABASE_PATH=data/askmate.db

# 필수. 아래 명령으로 생성한 값을 넣으세요. 실제 키는 Git에 올리지 않습니다.
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# 로그인 후 유효기간(초). 재접속만으로 연장되지 않습니다.
SESSION_MAX_AGE=3600
# 로컬 HTTP는 false, HTTPS 배포에서는 true로 설정합니다.
SESSION_HTTPS_ONLY=false

# AI 통신 설정. 모두 필수이며, 없으면 앱이 시작하지 않습니다.
# 실제 키는 .env 또는 배포 환경변수에만 두고 Git에 올리지 않습니다.
AI_API_KEY=
# Codyssey가 제공하는 OpenAI 호환 게이트웨이 주소입니다.
AI_BASE_URL=https://copa.codyssey.kr/v1
# 사용할 모델 이름. 목록은 docs/LLM.md를 참고하세요.
AI_MODEL=gpt-5.4-mini
# AI 응답 제한 시간(초). 초과하면 504로 응답합니다.
AI_TIMEOUT=30
